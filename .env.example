# ============================================
# TNR 流浪动物管理系统 - 环境变量示例
# 复制为 .env 并按需修改: cp .env.example .env
#
# 生产环境注意：不要直接照抄本文件！本文件是**开发环境**模板
# （DEBUG=True / SECRET_KEY 为占位符）。生产部署请使用 deploy.sh，
# 它会自动生成随机 SECRET_KEY 与数据库口令。
# ============================================

# ---------- Django ----------
# 生产环境必须改为 False，否则完整堆栈与 settings 会暴露给访问者。
DEBUG=True
# 生产环境必须替换为随机长字符串（本值是占位符，人人可知）：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# 注意变量名就是 SECRET_KEY，没有 DJANGO_ 前缀。
# 生产环境（DEBUG=False）下若未设置，应用会直接启动失败——这是有意为之。
SECRET_KEY=change-me-in-production
# 生产环境必须填写真实域名/IP，不能留 *（Host 头伪造可被用于
# 密码重置链接投毒、缓存污染）。生产环境未设置同样会启动失败。
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- HTTPS ----------
# 执行完 certbot 拿到证书后改为 on，会一并启用
# Secure Cookie / HSTS / 强制跳转 HTTPS。
HTTPS=off
# 通过域名（或 https）访问时 Django 会校验 Origin/Referer，
# 未列入的域名提交表单会 403。多个用逗号分隔。
CSRF_TRUSTED_ORIGINS=

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- Database ----------
# 开发用 sqlite3，生产用 mysql
DB_ENGINE=sqlite3
# DB_NAME=tnr_system
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ---------- 地图服务 ----------
# 高德开放平台 https://lbs.amap.com 注册后创建应用，选择"Web服务"类型 Key。
# 用于捕捉登记"定位"功能的逆地理编码（经纬度 → 地址名称），由后端代理调用。
# 未配置则前端定位功能不可用。
TNR_AMAP_KEY=
# 应用安全密钥（jscode，供 JS API Loader 使用；Web服务 REST 调用不需要）
# TNR_AMAP_SECURITY_CODE=

# ---------- 部署脚本（仅 deploy.sh 读取） ----------
# 超级管理员口令。不设置则由脚本随机生成并打印一次。
# ADMIN_PASSWORD=
