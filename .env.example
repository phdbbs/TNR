# ============================================
# TNR 流浪动物管理系统 - 环境变量示例
# 复制为 .env 并按需修改: cp .env.example .env
# ============================================

# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*

# Database (sqlite3 for dev, mysql for production)
DB_ENGINE=sqlite3
# DB_NAME=tnr_system
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# 地图服务（高德开放平台 https://lbs.amap.com 注册后创建应用，选择"Web服务"类型 Key）
# 用于捕捉登记"定位"功能的逆地理编码（经纬度 → 地址名称），由后端代理调用
TNR_AMAP_KEY=
