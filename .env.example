# ============================================
# TNR 流浪动物管理系统 - 环境变量示例
# 复制为 .env 并按需修改: cp .env.example .env
#
# 生产环境注意：不要直接照抄本文件！本文件是**开发环境**模板
# （DEBUG=True / SECRET_KEY 为占位符）。生产部署请使用 deploy.sh，
# 它会自动生成随机 SECRET_KEY 与数据库口令。
# ============================================

# ---------- Django ----------
# 生产环境必须改为 False，否则完整堆栈与 settings 会暴露给访问者。
DEBUG=True
# 生产环境必须替换为随机长字符串（本值是占位符，人人可知）：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# 注意变量名就是 SECRET_KEY，没有 DJANGO_ 前缀。
# 生产环境（DEBUG=False）下若未设置，应用会直接启动失败——这是有意为之。
SECRET_KEY=change-me-in-production
# 生产环境必须填写真实域名/IP，不能留 *（Host 头伪造可被用于
# 密码重置链接投毒、缓存污染）。生产环境未设置同样会启动失败。
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- HTTPS ----------
# 执行完 certbot 拿到证书后改为 on，会一并启用
# Secure Cookie / HSTS / 强制跳转 HTTPS。
HTTPS=off
# 通过域名（或 https）访问时 Django 会校验 Origin/Referer，
# 未列入的域名提交表单会 403。多个用逗号分隔。
CSRF_TRUSTED_ORIGINS=

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- Database ----------
# 开发用 sqlite3，生产用 mysql
DB_ENGINE=sqlite3
# DB_NAME=tnr_system
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ---------- 地图服务 ----------
# 高德开放平台 https://lbs.amap.com 注册后创建应用，选择"Web服务"类型 Key。
# 用于捕捉登记"定位"功能的逆地理编码（经纬度 → 地址名称），由后端代理调用。
# 未配置则前端定位功能不可用。
TNR_AMAP_KEY=
# 应用安全密钥（jscode，供 JS API Loader 使用；Web服务 REST 调用不需要）
# TNR_AMAP_SECURITY_CODE=

# ---------- 媒体文件存储（图片上传） ----------
# 默认 local：存到项目下的 media/ 目录，与改造前行为完全一致。
#
# 切到对象存储（腾讯云 COS / 阿里云 OSS / MinIO 等 S3 兼容服务）只需三步：
#   1) pip install "django-storages[s3]"
#   2) 把下面 TNR_MEDIA_STORAGE 改成 cos（或 oss / s3 / minio）并填桶与密钥
#   3) python manage.py media_migrate --apply     ← 把存量图片搬过去
# 迁移期间服务可继续读写（命令是幂等的，可重复执行、可中断重跑）。
#
# ⚠ 两个**设了就别再改**的值：TNR_MEDIA_STORAGE 与 TNR_MEDIA_LOCATION。
#   它们决定 object key（= 数据库里存的图片路径）。改了等于全部历史图片失联。
TNR_MEDIA_STORAGE=local
# TNR_MEDIA_BUCKET=tnr-media-1250000000
# TNR_MEDIA_REGION=ap-guangzhou
# COS 需显式指定端点；用 AWS S3 可留空走厂商默认。
# TNR_MEDIA_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# TNR_MEDIA_ACCESS_KEY_ID=
# TNR_MEDIA_SECRET_ACCESS_KEY=
# CDN / 自定义域名。设了则图片 URL 直接返回它（可被 CDN 缓存）。
# TNR_MEDIA_CUSTOM_DOMAIN=
# 桶内前缀。**设了就别改**（会改变 object key）。留空即直接放在桶根。
# TNR_MEDIA_LOCATION=
# 桶是私有时设为 true，图片 URL 会带时效签名；公开读桶保持 false。
# TNR_MEDIA_QUERYSTRING_AUTH=false

# ---------- 部署脚本（仅 deploy.sh 读取） ----------
# 超级管理员口令。不设置则由脚本随机生成并打印一次。
# ADMIN_PASSWORD=
